{
  "name": "agent-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Cockpit — local/remote desktop cockpit for driving a CLI coding agent",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "helper:build": "bash remote-helper/build.sh",
    "postinstall": "node scripts/strip-cpu-features.mjs",
    "predev": "npm run helper:build",
    "prebuild": "npm run helper:build",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -c.extraMetadata.version=\"$(node scripts/release-version.mjs)\"",
    "package:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -c.extraMetadata.version=\"$(node scripts/release-version.mjs)\"",
    "package:linux": "npm run build && electron-builder --linux -c.extraMetadata.version=\"$(node scripts/release-version.mjs)\"",
    "package:dir": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir -c.extraMetadata.version=\"$(node scripts/release-version.mjs)\"",
    "typecheck": "tsc -b --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "npm run build && node scripts/screenshots/capture.mjs",
    "verify:content-modes": "npm run build && node scripts/screenshots/verify-content-modes.mjs"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "^1.22.1",
    "@mermaid-js/layout-elk": "^0.2.1",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@wterm/dom": "^0.3.0",
    "@wterm/ghostty": "^0.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.1",
    "dockview-react": "^4.0.0",
    "dompurify": "^3.4.11",
    "font-list": "^2.1.0",
    "ignore": "^7.0.5",
    "mermaid": "^11.4.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-error-boundary": "^4.1.2",
    "rehype": "^13.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-rehype": "^11.1.0",
    "shiki": "^4.2.0",
    "simple-git": "^3.27.0",
    "ssh2": "^1.17.0",
    "unified": "^11.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "jsdom": {
      "undici": "^7.28.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "cpu-features": true,
    "electron": true,
    "esbuild": true,
    "fsevents": true,
    "node-pty": true,
    "electron-winstaller": true,
    "ssh2": true
  }
}
